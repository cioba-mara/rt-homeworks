/></mxGeometry></mxCell><mxCell id="c90" value="" style="html=1;edgeStyle=none;strokeColor=#c62828;strokeWidth=2;endArrow=none;endFill=0;startArrow=none;startFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="34" y="724" as="sourcePoint"/><mxPoint x="46" y="736" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c91" value="" style="html=1;edgeStyle=none;strokeColor=#c62828;strokeWidth=2;endArrow=none;endFill=0;startArrow=none;startFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="34" y="736" as="sourcePoint"/><mxPoint x="46" y="724" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c92" value="eveniment respins (interval minim încălcat)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="84" y="728" width="340" height="24" as="geometry"/></mxCell><mxCell id="c93" value="" style="html=1;edgeStyle=none;strokeColor=#c62828;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="724" as="sourcePoint"/><mxPoint x="450" y="762" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c94" value="termen-limită absolut d = r + D" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="468" y="732" width="300" height="24" as="geometry"/></mxCell><mxCell id="c95" value="" style="html=1;edgeStyle=none;strokeColor=#999999;strokeWidth=1;endArrow=none;endFill=0;startArrow=none;startFill=0;dashed=1;dashPattern=3 3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="724" as="sourcePoint"/><mxPoint x="790" y="762" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c96" value="evenimentul pus în coada alarmEvents" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="808" y="732" width="340" height="24" as="geometry"/></mxCell><mxCell id="c97" value="&lt;b&gt;Ce se vede în diagramă&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="790" width="1120" height="20" as="geometry"/></mxCell><mxCell id="c98" value="• τ1 se eliberează pe grila r_k = r_0 + k·T, cu T = 2000; fiecare job are termenul absolut d = r + D, cu D = T. Timpul de răspuns al fiecărui job este R = C = 300 ≤ D.&lt;br&gt;• Jobul J1 (eliberat la t = 2000) găsește temperatura peste prag și pune un eveniment în alarmEvents la t = 2300; τ2 îl acceptă (prima alarmă) și îl publică: R = 200 ≤ D = 1000.&lt;br&gt;• Jobul J2 (t = 4000) găsește din nou temperatura peste prag, dar evenimentul de la t = 4300 vine la doar 2000 ms după eliberarea precedentă (4300 − 2300 &amp;lt; 5000): este respins.&lt;br&gt;• La t = 5500 sosește comanda STATUS; τ3 o execută imediat (R = 150) și publică confirmarea; taskul aperiodic nu are termen hard și nu influențează grila lui τ1." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="812" width="1120" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>