ell id="c77" value="&lt;i&gt;IMqtt&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#000000;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="980" y="360" width="100" height="18" as="geometry"/></mxCell><mxCell id="c78" value="abonare: telemetry,&lt;br&gt;alarm, status&lt;br&gt;publică: commands" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=10;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="960" y="424" width="140" height="48" as="geometry"/></mxCell><mxCell id="c79" value="&lt;b&gt;Notație&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="600" width="700" height="20" as="geometry"/></mxCell><mxCell id="c80" value="• dreptunghiuri «component»: părți ale sistemului; în interiorul device-simulator și business-service sunt clasele Java ale aplicației (câte un thread pentru fiecare task / procesor de mesaje).&lt;br&gt;• bila (cerc): interfața oferită de o componentă; semicercul (arc): interfața folosită. Cele două aplicații folosesc interfața IMqtt (publish/subscribe), oferită de brokerul MQTT; nu comunică direct între ele.&lt;br&gt;• săgeată punctată: dependență (apel de metodă sau coadă BlockingQueue); eticheta spune ce se apelează sau ce se transmite.&lt;br&gt;• topic-uri: ssatr/&amp;lt;student&amp;gt;/devices/&amp;lt;id&amp;gt;/telemetry | alarm | status | commands (&amp;lt;id&amp;gt; = device-1, device-2, …)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="622" width="1680" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="seq-alarma" name="Secvență – alarmă"><mxGraphModel dx="1000" dy="8